{
  "name": "VitePaper",
  "version": "1.0.0",
  "description": "Self-hosted VitePress blog published from an Outline wiki, with an AstroPaper-inspired theme",
  "private": true,
  "scripts": {
    "docs:dev": "vitepress dev content",
    "docs:build": "vitepress build content",
    "docs:preview": "vitepress preview content",
    "sync": "node --env-file-if-exists=.env scripts/sync.ts",
    "sync:drafts": "node --env-file-if-exists=.env scripts/sync.ts --drafts",
    "migrate:code-tabs": "node --env-file-if-exists=.env scripts/migrate-code-tabs.ts",
    "serve": "node --env-file-if-exists=.env scripts/server.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:site": "node scripts/build-fixture-site.ts && vitest run --config vitest.site.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.8.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdit/plugin-figure": "^1.2.2",
    "@mdit/plugin-img-size": "^1.1.2",
    "@mdit/plugin-mark": "^2.1.2",
    "@mdit/plugin-tasklist": "^1.1.3",
    "@nolebase/markdown-it-unlazy-img": "^2.18.2",
    "@nolebase/vitepress-plugin-enhanced-mark": "^2.18.2",
    "@nolebase/vitepress-plugin-highlight-targeted-heading": "^2.18.2",
    "@nolebase/vitepress-plugin-inline-link-preview": "^2.18.2",
    "@nolebase/vitepress-plugin-meta": "^2.18.2",
    "@nolebase/vitepress-plugin-og-image": "^2.18.2",
    "@nolebase/vitepress-plugin-thumbnail-hash": "^2.18.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.3",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "markdown-it-container": "4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mathjax3": "^5.2.0",
    "mermaid": "^12.0.0",
    "node-html-parser": "^9.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.7",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "sirv": "^3.0.2"
  }
}
