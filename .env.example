# Outline Instance URL
OUTLINE_URL=https://outline.example.com

# Outline API Key (Create under Outline -> Settings -> API & Apps)
OUTLINE_API_KEY=ol_api_your_token_here

# Outline Webhook Signing Secret (Create under Outline -> Settings -> Webhooks)
OUTLINE_WEBHOOK_SECRET=ol_whs_your_secret_here

# Optional Outline collection / folder overrides:
# OUTLINE_COLLECTION=Blog
# OUTLINE_PUBLISHED_FOLDER=Published
# OUTLINE_DRAFTS_FOLDER=Drafts

# Optional Site Branding overrides (if not using vitepaper.local.ts):
# SITE_TITLE=My Blog
# SITE_LOGO=lucide:book-open
# SITE_DESCRIPTION=Personal technical blog.
# SITE_INTRO=Welcome to my personal technical blog.
# SITE_URL=https://blog.example.com
# SITE_AUTHOR=Your Name
# SITE_SOCIALS=github:https://github.com/username,mail:mailto:hello@example.com,rss:/rss.xml
